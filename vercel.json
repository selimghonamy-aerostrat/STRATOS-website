{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.dc.html"
    },
    {
      "source": "/about",
      "destination": "/About.dc.html"
    },
    {
      "source": "/solutions",
      "destination": "/Solutions.dc.html"
    },
    {
      "source": "/ebt-cbta",
      "destination": "/EBT-CBTA.dc.html"
    },
    {
      "source": "/tms",
      "destination": "/TMS.dc.html"
    },
    {
      "source": "/clients",
      "destination": "/Clients.dc.html"
    },
    {
      "source": "/contact",
      "destination": "/Contact.dc.html"
    },
    {
      "source": "/index.md",
      "destination": "/md/index.md"
    },
    {
      "source": "/about.md",
      "destination": "/md/about.md"
    },
    {
      "source": "/solutions.md",
      "destination": "/md/solutions.md"
    },
    {
      "source": "/ebt-cbta.md",
      "destination": "/md/ebt-cbta.md"
    },
    {
      "source": "/tms.md",
      "destination": "/md/tms.md"
    },
    {
      "source": "/clients.md",
      "destination": "/md/clients.md"
    },
    {
      "source": "/contact.md",
      "destination": "/md/contact.md"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon-96.png"
    }
  ],
  "headers": [
    {
      "source": "/(llms|llms-full)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "<https://aero-strat.com/>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/about.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "<https://aero-strat.com/about>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/solutions.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "<https://aero-strat.com/solutions>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/ebt-cbta.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "<https://aero-strat.com/ebt-cbta>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/tms.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "<https://aero-strat.com/tms>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/clients.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "<https://aero-strat.com/clients>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/contact.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "<https://aero-strat.com/contact>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/md/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/uploads/AeroStrat_EBT_CBTA_Handbook.pdf",
      "destination": "/ebt-cbta",
      "permanent": false
    }
  ]
}
